# .env로 복사한 뒤 값을 채우세요: cp .env.example .env && chmod 600 .env
# ANTHROPIC_API_KEY는 넣지 마세요. 넣으면 구독 대신 API 요금이 청구됩니다.

# 감시할 Drive 폴더 ID (https://drive.google.com/drive/folders/<여기>)
DRIVE_FOLDER_ID=

# Google 인증 플랫폼 → 클라이언트 → (데스크톱 앱 클라이언트)에 보이는 값
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 위 두 값 대신 클라이언트 JSON 파일을 쓸 수도 있음
# GOOGLE_OAUTH_CLIENT_FILE=~/.config/drive2notion/google-oauth-client.json
# `drive2notion auth` 로그인 후 저장되는 토큰 (기본 경로를 쓰면 비워 둬도 됨)
# GOOGLE_TOKEN_FILE=~/.config/drive2notion/google-token.json

NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
